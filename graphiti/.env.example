# Copy to .env and fill in. Only GEMINI_API_KEY is required; everything else has
# an in-code default in run_ingestion.py and is read via os.getenv, so an empty
# .env reproduces the committed behaviour.

# --- Credentials -----------------------------------------------------------
GEMINI_API_KEY=

# --- Neo4j -----------------------------------------------------------------
# Must point at the same database the retrieval side reads from
# (retrieval/.env). These were previously literals in run_ingestion.py, which
# put a password in source control and meant two places to edit when the DB moved.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin1234

# --- Extraction models -----------------------------------------------------
# INGEST_MODEL does entity/edge extraction and is the main cost and quality
# driver; the small model handles reranking and cheaper sub-tasks.
INGEST_MODEL=gemini-3.1-pro-preview
INGEST_SMALL_MODEL=gemini-3.6-flash
INGEST_EMBEDDING_MODEL=gemini-embedding-001

# graphiti's own per-model table doesn't recognise the pro-preview name and would
# silently cap output at 8192 tokens, truncating structured JSON on dense
# episodes ("Unterminated string" parse errors).
INGEST_MAX_TOKENS=65536

# Concurrent episode processing.
INGEST_CONCURRENCY_LIMIT=50

# --- Resume ----------------------------------------------------------------
# 0 runs a full rebuild and CLEARS the graph first. Set to the 0-indexed episode
# a previous run stopped at to continue it instead -- any non-zero value also
# skips clear_data(), so a resume cannot wipe the episodes it is resuming from.
INGEST_RESUME_FROM_INDEX=0
