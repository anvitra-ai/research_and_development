  {s:'E_HORMUZ', t:'E_AIBUILD', r:'HURT_BY', o:2, ch:'LNG/power cost -> DC opex (power ~50% of opex)'},
  {s:'M_WARRISK', t:'E_AIBUILD', r:'HURT_BY', o:2, ch:'freight + war risk on imported transformers, chillers, GPUs'},
  {s:'M_INR', t:'C_NETWEB', r:'HURT_BY', o:3, ch:'USD-denominated GPU landed cost'},
  {s:'M_REPO', t:'C_ADANIGREEN', r:'HURT_BY', o:3, ch:'long-duration project WACC'},
  {s:'M_REPO', t:'C_ANANTRAJ', r:'HURT_BY', o:3, ch:'DC project financing cost'}
] AS e

MATCH (a:Node {id: e.s})
MATCH (b:Node {id: e.t})

CREATE (a)-[rel:$(e.r)]->(b)

SET rel.order = e.o,
    rel.sign = e.sign,
    rel.channel = e.ch

RETURN count(rel) AS edges_created;
// NOTE: the final block requires APOC. Without APOC, replace with explicit
// MERGE (a)-[:CAUSES {..}]->(b) statements grouped by relationship type.

// ------------------------------------------------------------
// 4. SAMPLE QUERIES
// ------------------------------------------------------------
// Cross-theme companies:
//   MATCH (c:Node {type:'COMPANY'}) WHERE 'A' IN c.themes AND 'B' IN c.themes RETURN c.label, c.ticker;
//
// All 2nd-order Hormuz losers:
//   MATCH (c:Node {type:'COMPANY'})-[r:HURT_BY]->(m) WHERE r.order = 2 RETURN c.label, type(r), m.label, r.channel;
//
// Shortest causal path from the shock to any company:
//   MATCH p = shortestPath((:Node {id:'E_HORMUZ'})-[*..4]-(c:Node {ticker:'MRF'})) RETURN p;
//
// Bottleneck suppliers in Theme B:
//   MATCH (:Node {id:'E_AIBUILD'})-[:CONSTRAINED_BY]->(cn)<-[]-(c:Node {type:'COMPANY'}) RETURN cn.label, collect(c.ticker);
