// Companion to india_theme_kg.md · compiled 2026-08-05
// Research scaffold only. Not investment advice.
// ============================================================

CREATE CONSTRAINT node_id IF NOT EXISTS FOR (n:Node) REQUIRE n.id IS UNIQUE;

