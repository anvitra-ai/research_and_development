# Copy to .env and fill in. Every value below is OPTIONAL except GEMINI_API_KEY --
# each has an in-code default in src/formica_retrieval/config.py, so an empty .env
# runs exactly like the committed defaults. Set a variable only to override.
#
# A malformed numeric value logs a warning and falls back to the default rather
# than raising, so a typo here cannot kill a long benchmark run mid-flight.

# --- Credentials -----------------------------------------------------------
GEMINI_API_KEY=

# --- Neo4j -----------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin1234

# --- Models ----------------------------------------------------------------
# Summarisation uses the stronger reasoning model; judging uses the cheap fast
# one. Keep them separate: the judge is a measuring instrument, and changing it
# invalidates comparisons against earlier benchmark runs.
SUMMARY_MODEL=gemini-3.1-pro-preview
JUDGE_MODEL=gemini-3.5-flash-lite
NER_MODEL=dslim/bert-base-NER
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Both generation ends are greedy so a score change is attributable to a pipeline
# change rather than to sampling. Raising these reintroduces run-to-run noise.
SUMMARY_TEMPERATURE=0.0
JUDGE_TEMPERATURE=0.0
# GeminiClient's per-model default doesn't recognise the pro-preview name and
# silently caps output at 8192 tokens.
SUMMARY_MAX_TOKENS=65536

# --- Retrieval tuning ------------------------------------------------------
# Minimum similarity for a candidate row set to be accepted by the execution
# cascade; below it, the cascade keeps looking for a better strategy.
RELEVANCE_FLOOR=0.32

# Row budgets handed to the summariser. The default cap stops a long tail of
# loosely-related facts burying the row that holds the answer. The enumeration
# cap is deliberately larger: "which banks..." questions need breadth to be
# answerable at all, so the anti-dilution cap works against them.
MAX_MERGED_ROWS=40
MAX_ENUMERATION_ROWS=90

# Semantic-search supplement merged on top of the template's own Cypher result.
MAX_SUPPLEMENT_ROWS=8
SUPPLEMENT_MIN_SIMILARITY=0.35

# SWOT/analytical questions ("primary competitive advantage", "key strength")
# must synthesise across scattered facts, so they get a wider, lower-threshold
# net than a single-fact lookup.
ANALYTICAL_SUPPLEMENT_ROWS=30
ANALYTICAL_MIN_SIMILARITY=0.20

# Below this many retrieved rows, the entity's `summary` profile is appended as
# fallback context. Kept low-ish: the profile is long and crowds out precise
# facts in results that already have them.
PROFILE_ROW_THRESHOLD=25

# --- Evaluation ------------------------------------------------------------
# Share of the ground truth's material tokens that must be present before a
# failure is attributed to generation rather than retrieval. 1.0 means the whole
# answer had to be retrieved before the summariser is blamed.
RETRIEVAL_HIT_THRESHOLD=1.0
